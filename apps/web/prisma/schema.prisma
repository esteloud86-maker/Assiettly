// Schéma Prisma — Assiettly
// Hébergé sur Supabase : l'authentification (table auth.users) est gérée par
// Supabase Auth. `Profile.id` réutilise le même UUID que auth.users.id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler transaction-mode (pgbouncer) : utilisé par l'app à l'exécution.
  url       = env("DATABASE_URL")
  // Connexion directe/session : utilisée par Prisma pour les migrations
  // (le mode transaction du pooler ne supporte pas les DDL/verrous nécessaires).
  directUrl = env("DIRECT_URL")
}

enum Sexe {
  HOMME
  FEMME
}

enum NiveauActivite {
  SEDENTAIRE
  LEGER
  MODERE
  ACTIF
  TRES_ACTIF
}

enum ObjectifType {
  PERTE
  MAINTIEN
  PRISE_MASSE
}

enum MealType {
  PETIT_DEJ
  DEJEUNER
  DINER
  COLLATION
}

enum FoodSource {
  MANUEL
  OPEN_FOOD_FACTS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Profile {
  id                 String          @id @db.Uuid
  email              String          @unique
  nom                String?
  dateNaissance      DateTime?       @map("date_naissance") @db.Date
  sexe               Sexe?
  tailleCm           Int?            @map("taille_cm")
  poidsCibleKg       Decimal?        @map("poids_cible_kg") @db.Decimal(5, 2)
  niveauActivite     NiveauActivite? @map("niveau_activite")
  frequenceSportParSemaine Int?      @map("frequence_sport_semaine")
  objectifType       ObjectifType?   @map("objectif_type")
  onboardingTermine  Boolean         @default(false) @map("onboarding_termine")
  stripeCustomerId   String?         @unique @map("stripe_customer_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  goals             Goal[]
  weightLogs        WeightLog[]
  meals             Meal[]
  streakDays        StreakDay[]
  streakSummary     StreakSummary?
  subscription      Subscription?
  pushSubscriptions PushSubscription[]

  @@map("profiles")
}

model Goal {
  id                   String   @id @default(uuid()) @db.Uuid
  profileId            String   @map("profile_id") @db.Uuid
  profile              Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  objectifCaloriesKcal Int      @map("objectif_calories_kcal")
  objectifProteinesG   Int      @map("objectif_proteines_g")
  objectifGlucidesG    Int      @map("objectif_glucides_g")
  objectifLipidesG     Int      @map("objectif_lipides_g")
  tolerancePct         Int      @default(10) @map("tolerance_pct")
  actif                Boolean  @default(true)
  actifDepuis          DateTime @default(now()) @map("actif_depuis")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([profileId, actif])
  @@map("user_goals")
}

model WeightLog {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  poidsKg   Decimal  @map("poids_kg") @db.Decimal(5, 2)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([profileId, date])
  @@map("weight_logs")
}

model Food {
  id                 String     @id @default(uuid()) @db.Uuid
  nom                String
  marque             String?
  source             FoodSource @default(MANUEL)
  codeBarre          String?    @unique @map("code_barre")
  caloriesKcal100g   Decimal    @map("calories_kcal_100g") @db.Decimal(6, 2)
  proteinesG100g     Decimal    @map("proteines_g_100g") @db.Decimal(6, 2)
  glucidesG100g      Decimal    @map("glucides_g_100g") @db.Decimal(6, 2)
  lipidesG100g       Decimal    @map("lipides_g_100g") @db.Decimal(6, 2)
  fibresG100g        Decimal?   @map("fibres_g_100g") @db.Decimal(6, 2)
  createdByProfileId String?    @map("created_by_profile_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at")

  mealItems MealItem[]

  @@index([nom])
  @@map("foods")
}

model Meal {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  type      MealType
  createdAt DateTime @default(now()) @map("created_at")

  items MealItem[]

  @@index([profileId, date])
  @@map("meals")
}

model MealItem {
  id           String   @id @default(uuid()) @db.Uuid
  mealId       String   @map("meal_id") @db.Uuid
  meal         Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId       String?  @map("food_id") @db.Uuid
  food         Food?    @relation(fields: [foodId], references: [id])
  nomLibre     String?  @map("nom_libre")
  quantiteG    Decimal  @map("quantite_g") @db.Decimal(7, 2)
  caloriesKcal Decimal  @map("calories_kcal") @db.Decimal(7, 2)
  proteinesG   Decimal  @map("proteines_g") @db.Decimal(6, 2)
  glucidesG    Decimal  @map("glucides_g") @db.Decimal(6, 2)
  lipidesG     Decimal  @map("lipides_g") @db.Decimal(6, 2)
  fibresG      Decimal? @map("fibres_g") @db.Decimal(6, 2)

  @@map("meal_items")
}

model StreakDay {
  id               String   @id @default(uuid()) @db.Uuid
  profileId        String   @map("profile_id") @db.Uuid
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  flammeAllumee    Boolean  @default(false) @map("flamme_allumee")
  freezeUtilise    Boolean  @default(false) @map("freeze_utilise")
  caloriesJour     Int      @map("calories_jour")
  objectifRespecte Boolean  @map("objectif_respecte")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([profileId, date])
  @@map("streak_days")
}

model StreakSummary {
  profileId           String    @id @map("profile_id") @db.Uuid
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  streakActuel        Int       @default(0) @map("streak_actuel")
  streakMax           Int       @default(0) @map("streak_max")
  freezesUtilisesMois Int       @default(0) @map("freezes_utilises_mois")
  moisReferenceFreeze DateTime? @map("mois_reference_freeze") @db.Date
  dernierJourFlamme   DateTime? @map("dernier_jour_flamme") @db.Date
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("streak_summaries")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  profileId            String             @unique @map("profile_id") @db.Uuid
  profile              Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  status               SubscriptionStatus
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd     Boolean           @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId])
  @@map("push_subscriptions")
}
