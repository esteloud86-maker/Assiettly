# Connexion Postgres (Supabase : bouton "Connect" en haut du dashboard > onglet "ORM" > Prisma)
# DATABASE_URL = pooler transaction-mode (utilisé à l'exécution par l'app)
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = pooler session-mode / connexion directe (utilisé par Prisma pour les migrations)
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-clé-anon-publique-supabase"

# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MENSUEL="price_..."
STRIPE_PRICE_ID_ANNUEL="price_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic (scan de repas par photo — IA vision, claude-sonnet-4-5)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend (rappels de flamme quotidiens par e-mail)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Assiettly <bonjour@assiettly.fr>"
# Secret partagé avec Vercel Cron pour protéger la route /api/cron/* (chaîne aléatoire de ton choix)
CRON_SECRET="choisis-une-chaine-aleatoire-longue"

# Notifications push (générées une fois avec `npx web-push generate-vapid-keys`, à ne jamais régénérer ensuite)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:bonjour@assiettly.fr"
